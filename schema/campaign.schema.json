{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ranges.io campaign",
  "type": "object",
  "properties": {
    "ranges_io": {
      "type": "object",
      "properties": {
        "package": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "notes": {
              "type": "string"
            },
            "uuid": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "hint_policy": {
          "type": "object",
          "properties": {
            "penalty": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "avatar": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "appear_as_player": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "challenges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "short_title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "long_title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "briefing": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "answer": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "Acknowledged"
                      },
                      "points": {
                        "type": "integer"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "Case sensitive"
                      },
                      "points": {
                        "type": "integer"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "mode",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "Case insensitive"
                      },
                      "points": {
                        "type": "integer"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "mode",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "Integer"
                      },
                      "points": {
                        "type": "integer"
                      },
                      "value": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "mode",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "Multiple choice"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            },
                            "correct": {
                              "type": "boolean"
                            },
                            "points": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "value",
                            "correct",
                            "points"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 2
                      },
                      "random": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "mode",
                      "options"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "Prefixed"
                      },
                      "points": {
                        "type": "integer"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "prefix": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "mode",
                      "value",
                      "prefix"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "Regex"
                      },
                      "points": {
                        "type": "integer"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "validation": {
                        "type": "object",
                        "properties": {
                          "pattern": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "tip": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "pattern",
                          "message",
                          "tip"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "mode",
                      "value",
                      "validation"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "hints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0
              },
              "debrief": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "difficulty": {
                "enum": [
                  "Easy",
                  "Medium",
                  "Hard"
                ]
              },
              "external_reference": {
                "type": "string",
                "pattern": "^https?://\\S+$"
              }
            },
            "required": [
              "position",
              "group",
              "short_title",
              "briefing",
              "answer"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "stories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "autoplay": {
                "type": "boolean"
              },
              "actors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "trigger": {
                "type": "object",
                "properties": {
                  "challenge": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "challenge"
                ],
                "additionalProperties": false
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "actor": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "delay": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "actor",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "name",
              "actors",
              "trigger",
              "messages"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "package",
        "challenges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ranges_io"
  ],
  "additionalProperties": false
}
